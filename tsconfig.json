{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"noEmit": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["index.ts", "lib/**/*.ts", "test/**/*.ts", "vitest.config.mts"],
	"exclude": ["node_modules", "dist"]
}
